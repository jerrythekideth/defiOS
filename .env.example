# Copy to .env in YOUR agent repo (never commit it). Only names here, no values.

# JSON-RPC endpoint (reads, eth_call probes, optional log source)
RPC_URL=

# Etherscan v2 multichain key (preferred log source for Roles event replay)
ETHERSCAN_API_KEY=

# Log source for event replay: auto (Etherscan if key set, else RPC) | etherscan | rpc
LOG_SOURCE=auto
# eth_getLogs block range per request when LOG_SOURCE=rpc
LOGS_CHUNK=10000

# Safe Transaction Service API key (api.safe.global) for queues and delegates
SAFE_API_KEY=

# M2+: key of the proposer (a delegate on the Operator Safe only). Not used in M1.
PROPOSER_PRIVATE_KEY=
