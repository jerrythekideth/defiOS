# Copy to .env in YOUR agent repo (never commit it). Only names here, no values.

# JSON-RPC endpoint (reads, eth_call probes, optional log source)
RPC_URL=                 # or ETH_RPC_URL (read when RPC_URL is unset)

# Etherscan v2 multichain key (preferred log source for Roles event replay)
ETHERSCAN_API_KEY=

# Log source for event replay: auto (Etherscan if key set, else RPC) | etherscan | rpc
LOG_SOURCE=auto
# eth_getLogs block range per request when LOG_SOURCE=rpc
LOGS_CHUNK=10000

# Safe Transaction Service API key (api.safe.global) for queues and delegates
SAFE_API_KEY=             # optional; sent as bearer token when set

# Key of the proposer: a DELEGATE on the Operator Safe, never an owner. Only `defios propose`
# uses it (signs the SafeTxHash for the queue; dry run unless --send). Must match `proposer:`.
PROPOSER_PRIVATE_KEY=     # or ETH_PRIVATE_KEY (read when unset)

# Tenderly Simulation API (optional): `defios simulate --tenderly` runs the same bundle there and
# prints a dashboard link per transaction. Key: dashboard.tenderly.co > Settings > Access Keys.
TENDERLY_ACCESS_KEY=
TENDERLY_ACCOUNT=         # account slug, as in dashboard.tenderly.co/<account>/<project>
TENDERLY_PROJECT=         # project slug
